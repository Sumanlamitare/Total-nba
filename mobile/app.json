{
  "expo": {
    "name": "Turnout",
    "slug": "turnout",
    "scheme": "turnout",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "description": "Run pickup games without the group-chat chaos: RSVPs, waitlists, fair teams and results.",
    "ios": {
      "bundleIdentifier": "com.turnoutapp.pickup",
      "buildNumber": "1",
      "supportsTablet": false,
      "config": { "usesNonExemptEncryption": false },
      "infoPlist": { "ITSAppUsesNonExemptEncryption": false }
    },
    "android": {
      "package": "com.turnoutapp.pickup",
      "adaptiveIcon": { "backgroundColor": "#FF5A1F", "foregroundImage": "./assets/android-icon-foreground.png" }
    },
    "web": { "favicon": "./assets/favicon.png", "bundler": "metro" },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      ["expo-splash-screen", { "image": "./assets/splash-icon.png", "imageWidth": 160, "backgroundColor": "#FF5A1F" }],
      ["expo-notifications", { "color": "#FF5A1F" }]
    ],
    "experiments": { "typedRoutes": false },
    "extra": {
      "apiUrl": "https://total-nba-ja9d.vercel.app",
      "router": {},
      "eas": { "projectId": "" }
    }
  }
}
