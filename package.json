{
  "name": "beat-the-dynasty",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Beat the Dynasty: draft a starting five from random franchise and decade spins, then take on an NBA dynasty in a best-of-seven. Ratings from ESPN's season statistics.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:fixtures": "MOCK_API=test/fixtures node scripts/dev.mjs",
    "build": "vite build",
    "test": "node --test test/unit.test.mjs",
    "test:e2e": "node --test --test-concurrency=1 test/e2e.test.mjs",
    "test:ui": "node --test test/ui.test.mjs",
    "ingest": "node scripts/ingest.mjs --scan 8000"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "mongodb": "^6.21.0",
    "motion": "^12.43.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.21"
  }
}
