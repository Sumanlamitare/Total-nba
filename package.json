{
  "name": "football-past-90",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Football Past 90: automatic full-time graphics (Instagram 1080x1350) for 39 men's competitions, from ESPN. Keeps match data only until it is cleaned up; graphics are kept.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "worker": "node scripts/worker.mjs",
    "test": "node --test test/unit.test.mjs",
    "test:e2e": "node --test --test-concurrency=1 test/e2e.test.mjs",
    "test:ui": "node --test test/ui.test.mjs"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@vitejs/plugin-react": "^4.7.0",
    "mongodb": "^6.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.21"
  },
  "devDependencies": {
    "mingo": "^7.2.7",
    "opentype.js": "^2.0.0"
  }
}
