{
  "name": "overlap",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Overlap: automatic NBA statistical Venn diagrams, every night after the games and for the season, from ESPN box scores.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "test": "node --test test/unit.test.mjs",
    "test:e2e": "node --test --test-concurrency=1 test/e2e.test.mjs",
    "test:ui": "node --test test/ui.test.mjs",
    "auto": "node scripts/auto.mjs",
    "backfill": "node scripts/backfill.mjs"
  },
  "dependencies": {
    "@vercel/og": "^0.6.8",
    "@vitejs/plugin-react": "^4.7.0",
    "mongodb": "^6.21.0",
    "motion": "^12.43.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.21"
  }
}
