{
  "name": "performance-of-the-night",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Performance of the Night: the five best NBA performances of every night, scored from box scores, play-by-play and win probability, with a season leaderboard.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:fixtures": "MOCK_API=test/fixtures/api node scripts/dev.mjs",
    "build": "vite build",
    "test": "node --test test/unit.test.mjs",
    "test:e2e": "node --test --test-concurrency=1 test/e2e.test.mjs",
    "test:ui": "node --test test/ui.test.mjs",
    "ingest": "node scripts/ingest.mjs"
  },
  "dependencies": {
    "@vercel/og": "^0.6.8",
    "@vitejs/plugin-react": "^4.7.0",
    "mongodb": "^6.21.0",
    "motion": "^12.43.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.21"
  }
}
