{
  "name": "totalnba",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Personal NBA leaderboard (MERN)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "ingest": "node server/ingest/run.js",
    "probe:bbs": "node server/ingest/probe-bbs.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "mongoose": "^9.10.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.21"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
